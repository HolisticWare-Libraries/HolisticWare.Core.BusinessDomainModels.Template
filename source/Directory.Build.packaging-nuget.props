<Project>

    <!--
    https://learn.microsoft.com/en-us/nuget/create-packages/overview-and-workflow
    https://learn.microsoft.com/en-us/nuget/reference/msbuild-targets
    -->
    <PropertyGroup>
        <!--
        put the package output into a folder for nuget output
        -->
        <PackageOutputPath>
            ../../../../output
        </PackageOutputPath>
        <IsPackable>true</IsPackable>

        <!--
        If moved to separate PropertyGroup - UI is cleared?!?!
        -->
        <PackOnBuild>true</PackOnBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <CreatePackage>false</CreatePackage>
        <PackOnBuild>false</PackOnBuild>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <CreatePackage>true</CreatePackage>
        <PackOnBuild>true</PackOnBuild>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <PropertyGroup>
        <VersionPrefix>0.0.1</VersionPrefix>
        <!--
        VersionSuffix - For debugging and local GitHub feed
        -->
        <VersionSuffix>alpha-$([System.DateTime]::Now.ToString('yyyyMMddHHmm'))</VersionSuffix>
        <Version>
            1.0.0
        </Version>
        <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Copyright>2026</Copyright>
        <PackageId>
            HolisticWare.$(RootNamespace)
        </PackageId>
        <Title>
            HolisticWare.$(RootNamespace)
        </Title>
        <summary>
            HolisticWare.$(RootNamespace) .NET library implemented in C# for Business/Domain
        </summary>
        <Description>
            HolisticWare.$(RootNamespace) .NET library implemented in C# for Business/Domain
        </Description>
        <Owners>
            moljac;HolisticWare
        </Owners>
        <Authors>
            moljac;HolisticWare
        </Authors>
        <ProjectUrl>
            https://github.com/HolisticWare/HolisticWare.Core.Math.Discrete.GraphTheory
        </ProjectUrl>
        <PackageProjectUrl>
            https://github.com/HolisticWare/HolisticWare.Core.Math.Discrete.GraphTheory
        </PackageProjectUrl>
        <RepositoryUrl>
            https://github.com/HolisticWare/HolisticWare.Core.Math.Discrete.GraphTheory
        </RepositoryUrl>
        <license>LICENSE</license>
        <licenseUrl>
            https://github.com/HolisticWare/HolisticWare.Core.Math.Discrete.GraphTheory/blob/master/LICENSE
        </licenseUrl>
        <PackageLicenseUrl>
            https://github.com/HolisticWare/HolisticWare.Core.Math.Discrete.GraphTheory/blob/master/LICENSE
        </PackageLicenseUrl>
        <iconUrl>
            https://secure.gravatar.com/avatar/b662959e712466f393541935b664d3c5
        </iconUrl>
        <PackageIconUrl>
            https://secure.gravatar.com/avatar/b662959e712466f393541935b664d3c5
        </PackageIconUrl>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>
            moljac;HolisticWare
        </Authors>
        <Company>
            HolisticWare
        </Company>
        <PackageReadmeFile>
            readme.md
        </PackageReadmeFile>        
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>netstandard1.0</TargetFrameworks>
        <LangVersion>Latest</LangVersion>
        <RootNamespace>Core.Math.Discrete.GraphTheory</RootNamespace>
        <AssemblyName>HolisticWare.$(RootNamespace)</AssemblyName>
    </PropertyGroup>

</Project>