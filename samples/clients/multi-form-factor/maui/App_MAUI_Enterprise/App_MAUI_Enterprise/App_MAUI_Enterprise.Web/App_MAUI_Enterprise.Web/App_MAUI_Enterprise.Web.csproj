<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
		<TypeScriptBuildMode>true</TypeScriptBuildMode>
	</PropertyGroup>

	<ItemGroup>
		<Compile Update="**\*.Model.cs" DependentUpon="$([System.String]::Copy('%(FileName)').Replace('.Model', '.cshtml'))" />
		<Compile Update="**\*.ViewModel.cs" DependentUpon="$([System.String]::Copy('%(FileName)').Replace('.ViewModel', '.cshtml'))" />
		<Compile Update="**\*.Validator.cs" DependentUpon="$([System.String]::Copy('%(FileName)').Replace('.Validator', '.cshtml'))" />

		<Content Remove="bundleconfig.json" />
		<Content Remove="compilerconfig.json" />

		<None Include="bundleconfig.json" />
		<None Include="compilerconfig.json" />
		<None Include="**\*.cshtml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.3" />
		<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.4.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\App_MAUI_Enterprise.Core\App_MAUI_Enterprise.Core\App_MAUI_Enterprise.Core.csproj" />
	</ItemGroup>

</Project>