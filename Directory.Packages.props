<Project>
    <!--
        Central Package Management — all package versions defined here.
        Projects reference packages without Version attributes.
    -->

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <!-- ASP.NET Core / Blazor -->
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.51" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.3" />
        <PackageVersion Include="Microsoft.AspNetCore.OData" Version="9.4.1" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />

        <!-- MAUI -->
        <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.71" />
        <PackageVersion Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.71" />

        <!-- Database -->
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.8" />

        <!-- EF Core -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.3" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.3" />

        <!-- Aspire / Telemetry -->
        <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
        <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
        <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />

        <!--
        Blazor FluentUI
        -->
        <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.2" />
        <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.2" />
        <PackageVersion Include="Microsoft.Fast.Components.FluentUI" Version="3.0.18" />

        <!--
        Blazor shacdn-ui
        -->
        <PackageVersion Include="BlazorBlueprint.Components" Version="3.15.0" />
        <PackageVersion Include="BlazorBlueprint.Primitives" Version="3.15.0" />
        <PackageVersion Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />

        <!-- ML.NET -->
        <PackageVersion Include="Microsoft.ML" Version="3.0.1" />
        <PackageVersion Include="Microsoft.ML.CpuMath" Version="3.0.1" />

        <!-- Test SDK (common versions) -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />

        <!-- Testing frameworks -->
        <PackageVersion Include="MSTest" Version="4.2.3" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="TUnit" Version="1.56.18" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.v3" Version="3.1.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

        <!-- Playwright -->
        <PackageVersion Include="Microsoft.Playwright.MSTest" Version="1.60.0" />
        <PackageVersion Include="Microsoft.Playwright.Xunit" Version="1.60.0" />

        <!-- Test utilities -->
        <PackageVersion Include="Bogus" Version="35.5.0" />
        <PackageVersion Include="Moq" Version="4.20.70" />
        <PackageVersion Include="Shouldly" Version="4.2.1" />

        <!-- Logging -->
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />

        <!-- Tooling -->
        <PackageVersion Include="Microsoft.DependencyValidation.Analyzers" Version="0.11.0" />
        <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="5.4.3" />
        <PackageVersion Include="NUnitTestAdapter" Version="2.3.0" />

        <!-- Legacy Xamarin (samples only) -->
        <PackageVersion Include="Microsoft.MobileBlazorBindings" Version="0.5.50-preview" />
        <PackageVersion Include="Microsoft.MobileBlazorBindings.WebView.Android" Version="0.5.50-preview" />
        <PackageVersion Include="Microsoft.MobileBlazorBindings.WebView.iOS" Version="0.5.50-preview" />
        <PackageVersion Include="Microsoft.MobileBlazorBindings.WebView.macOS" Version="0.5.50-preview" />
        <PackageVersion Include="Microsoft.MobileBlazorBindings.WebView.Windows" Version="0.5.50-preview" />
        <PackageVersion Include="Xamarin.Essentials" Version="1.5.3.2" />
        <PackageVersion Include="Xamarin.Forms" Version="4.8.0.1451" />
        <PackageVersion Include="Xamarin.Forms.Platform.WPF" Version="4.8.0.1451" />
        <PackageVersion Include="Xamarin.UITest" Version="4.3.4" />

        <!-- .NET Core shared framework packages -->
        <PackageVersion Include="System.Memory" Version="4.5.5" />
        <PackageVersion Include="System.Net.Http.Json" Version="3.2.1" />
        <PackageVersion Include="System.Text.Encodings.Web" Version="4.7.1" />
        <PackageVersion Include="System.Text.Json" Version="4.7.2" />

        <!-- Third-party -->
        <PackageVersion Include="AvantiPoint.MauiMicroMvvm" Version="0.3.35" />
        <PackageVersion Include="BlazorBlueprint.Components" Version="3.2.0" />
        <PackageVersion Include="BlazorBlueprint.Icons.Lucide" Version="2.1.0" />
        <PackageVersion Include="BlazorBlueprint.Primitives" Version="3.2.0" />
        <PackageVersion Include="Clancey.Comet" Version="0.3.466-beta" />
        <PackageVersion Include="Reloadify3000" Version="1.0.8" />
    </ItemGroup>



</Project>
